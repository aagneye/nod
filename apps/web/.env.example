# Copy to apps/web/.env.local for local dev; set the same names in Vercel > Settings > Environment Variables.
# VITE_* values are baked into the browser bundle at build time (redeploy after changing them).
# NOD_* values are read by the /api functions at runtime and never reach the browser.

# --- Web app (public) ---
# chipnet (default) or mainnet. Must match NOD_NETWORK.
VITE_NETWORK=chipnet
# Team copy of the Widget Factory slide deck ("anyone with link can view").
VITE_SLIDES_URL=
# Team CashTokens address for EMBER2026 votes.
VITE_EMBER2026_ADDRESS=
# Optional: origin serving /api when it is not the same origin as the app.
VITE_API_BASE=

# --- Demo API (server only) ---
# chipnet or mainnet. Falls back to VITE_NETWORK, then chipnet.
NOD_NETWORK=chipnet
# Demo agent private key, 64 hex chars. Unset = ephemeral key per cold start (response carries a warning).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOD_DEMO_AGENT_KEY=
# Address the demo agent asks to be paid (bitcoincash:... on mainnet, bchtest:... on chipnet).
# Required on mainnet. On chipnet, unset = the agent key's own P2PKH address.
NOD_DEMO_VENDOR=
# Price of one demo purchase in satoshis (default 2000, minimum 546).
NOD_DEMO_SATS=2000
# Public origin used in request links, e.g. https://nod.vercel.app. Unset = the request's Host header.
NOD_PUBLIC_URL=
