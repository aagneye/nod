# Copy to apps/web/.env.local for local dev (Vite and the standalone server both read it).
# On a server, set the same names in the environment (real environment variables win over the file).
# VITE_* values are baked into the browser bundle at build time; everything else is read by the
# /api routes at runtime and never reaches the browser.
#
# Where the API runs:
#   npm run dev -w @nod/web          Vite dev server, /api from server/api.ts
#   npm run serve -w @nod/web        standalone server: app + /api on PORT (default 8787)
#   npm run build:vercel -w @nod/web Vercel functions. HSP only accepts allowlisted IPs and Vercel
#                                    functions have no fixed IP, so the HSP routes answer 503 there:
#                                    run the standalone server on an allowlisted machine and set
#                                    NOD_API_PROXY or VITE_API_BASE (below) at build time.

# --- Web app (public, build time) ---
# Origin serving /api when it is not the app's own origin, e.g. https://api.example.com
VITE_API_BASE=

# --- HSP (HashKey Settlement Platform) ---
# live (default): real HSP over MCP. mock: an in-memory simulation for development only
# (Sepolia test USDC, fake settlement tx; the on-chain check and receipt anchor are skipped).
HSP_MODE=live
# HSP Agentic Payment MCP endpoint (Streamable HTTP). Default: the QA environment.
HSP_MCP_URL=https://mcp-qa.hashkeymerchant.com/
# The team's HSP reporting name, sent with every order and status query. Required in live mode.
NOD_MERCHANT_NAME=
# Which get_chain_config option to pay with. Default: HSK Chain testnet USDC if offered, else the
# first USDC. Network name as HSP spells it (or a chain id), chain id, coin symbol.
NOD_PAY_NETWORK=
NOD_PAY_CHAIN_ID=
NOD_PAY_COIN=

# --- Contracts on HSK Chain ---
# hsk-testnet (default, chain 133) or hsk-mainnet (chain 177).
NOD_RECEIPTS_CHAIN=hsk-testnet
# NodReceipts and NodPolicy addresses (from contracts/deployments/<network>.json after a deploy).
NOD_RECEIPTS_ADDRESS=
NOD_POLICY_ADDRESS=
# Key that anchors receipts in NodReceipts (0x + 64 hex). Needs a little HSK for gas. Secret.
# Unset: settlement is still checked, but anchoring is skipped (the response says so).
NOD_RECORDER_KEY=
# Read-only alternative: the recorder address to look receipts up under, without the key.
NOD_RECORDER_ADDRESS=

# --- RPC endpoints (optional overrides) ---
# Defaults: https://mainnet.hsk.xyz, https://testnet.hsk.xyz, https://ethereum-sepolia-rpc.publicnode.com
HSK_MAINNET_RPC=
HSK_TESTNET_RPC=
SEPOLIA_RPC=

# --- Demo vendor agent (GET /api/demo-agent, POST /api/vendor/buy) ---
# Demo agent key (0x + 64 hex). Unset = an ephemeral key per process (responses carry a warning).
# Generate: node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
NOD_DEMO_AGENT_KEY=
# Address the demo agent asks to be paid (an address the team controls). Unset = the agent's own address.
NOD_DEMO_VENDOR=
# Price of one demo weather report in USD (default 0.10).
NOD_DEMO_USD=0.10

# --- Server ---
# Public origin used in links, e.g. https://nod.example. Unset = the request's own origin.
NOD_PUBLIC_URL=
# Access-Control-Allow-Origin for /api: * (default), a comma-separated list of origins, or off.
NOD_CORS_ORIGIN=
# Standalone server only: port, bind address, and the built app to serve (default dist/).
PORT=8787
HOST=0.0.0.0
NOD_STATIC_DIR=

# --- Vercel build only ---
# Origin of the standalone server: Vercel then proxies /api/* there instead of running functions.
NOD_API_PROXY=
