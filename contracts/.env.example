# Copy to contracts/.env (gitignored) or set these in your shell; shell values win over .env.
# hardhat.config.ts loads contracts/.env itself.

# Private key (0x-prefixed hex) of the account that deploys NodReceipts and NodPolicy.
# It needs native gas: HSK on HSK Chain, Sepolia ETH on Sepolia. Never commit a real key.
# Without it, the live networks have no accounts and the deploy script stops before sending anything.
DEPLOYER_PRIVATE_KEY=

# Optional Sepolia JSON-RPC URL. Default: https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=

# Must be "yes" to deploy to HSK Chain mainnet (chain id 177). It is IGNORED in this file on
# purpose: set it in the shell for the one mainnet deploy only.
#   bash:       CONFIRM_MAINNET=yes npm run deploy:hsk-mainnet -w @nod/contracts
#   PowerShell: $env:CONFIRM_MAINNET='yes'; npm run deploy:hsk-mainnet -w @nod/contracts; Remove-Item Env:CONFIRM_MAINNET
# CONFIRM_MAINNET=
